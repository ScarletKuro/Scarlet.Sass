<Project>
  <UsingTask TaskName="Scarlet.Sass.MSBuild.SassCompileTask"
             AssemblyFile="$(MSBuildThisFileDirectory)../tools/netstandard2.0/Scarlet.Sass.MSBuild.dll" />

  <Target Name="_SassResolveStampDirectory">
    <PropertyGroup>
      <_SassStampDirectory Condition="'$(SassStampDirectory)' != ''">$(SassStampDirectory)</_SassStampDirectory>
      <_SassStampDirectory Condition="'$(_SassStampDirectory)' == '' AND '$(IntermediateOutputPath)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Scarlet.Sass'))))</_SassStampDirectory>
    </PropertyGroup>
  </Target>

  <Target Name="RunSassBeforeStaticWebAssets"
          BeforeTargets="DispatchToInnerBuilds;ResolveProjectStaticWebAssets;PreBuildEvent"
          DependsOnTargets="_SassResolveStampDirectory"
          Returns="@(_SassContentChanges)"
          Condition="'$(SassEnabled)' == 'true' AND '@(SassBeforeStaticWebAssets)' != '' AND '$(DesignTimeBuild)' != 'true' AND '$(NoBuild)' != 'true' AND ('$(TargetFrameworks)' == '' OR '$(TargetFramework)' == '')">
    <SassCompileTask Compilations="@(SassBeforeStaticWebAssets)"
                     ProjectDirectory="$(MSBuildProjectDirectory)"
                     Configuration="$(Configuration)"
                     OutputStyle="$(SassOutputStyle)"
                     SourceMap="$(SassSourceMap)"
                     EmbedSources="$(SassEmbedSources)"
                     QuietDeps="$(SassQuietDeps)"
                     LoadPaths="$(SassLoadPaths)"
                     PkgImporter="$(SassPkgImporter)"
                     SilenceDeprecations="$(SassSilenceDeprecations)"
                     FatalDeprecations="$(SassFatalDeprecations)"
                     AdditionalArguments="$(SassAdditionalArguments)"
                     StampDirectory="$(_SassStampDirectory)"
                     RuntimeDirectory="$(SassRuntimeDirectory)"
                     SassRuntimeDownload="$(SassRuntimeDownload)"
                     SassVersionDownload="$(SassVersionDownload)"
                     DownloadMutexTimeoutSeconds="$(SassDownloadMutexTimeoutSeconds)"
                     TimeoutMilliseconds="$(SassTimeoutMilliseconds)"
                     RuntimePacks="@(SassRuntimePack)">
      <Output TaskParameter="GeneratedFiles" ItemName="_SassGeneratedFiles" />
      <Output TaskParameter="RemovedFiles" ItemName="_SassRemovedFiles" />
    </SassCompileTask>

    <!-- The task reports removed files as absolute paths, but the SDK's wwwroot glob holds them project-relative,
         and Remove inside a target matches item specs rather than resolved paths. Without the relative form the
         glob's stale entry survives - after deleting or renaming one stylesheet in a compiled directory - and the
         static web assets SDK fails the build on a file that is gone. -->
    <ItemGroup>
      <_SassRemovedContent Include="$([MSBuild]::MakeRelative($([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)')), '%(_SassRemovedFiles.FullPath)'))"
                           Condition="'@(_SassRemovedFiles)' != ''" />
      <Content Remove="@(_SassRemovedFiles);@(_SassRemovedContent)" />
      <None Remove="@(_SassRemovedFiles);@(_SassRemovedContent)" />
      <_SassGeneratedContent Include="%(_SassGeneratedFiles.RelativePath)" />
      <_SassNewContent Include="@(_SassGeneratedContent)" Exclude="@(Content)" />
      <Content Include="@(_SassNewContent)" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="@(_SassGeneratedFiles)" />
      <_SassContentChanges Include="@(_SassGeneratedContent)" Change="Generated" />
      <_SassContentChanges Include="@(_SassRemovedContent)" Change="Removed" />
    </ItemGroup>
  </Target>

  <!-- An inner build is not always reached through this project's own outer build. A ProjectReference from an
       app builds the referenced framework directly (dotnet run on the app never builds this project's outer
       build), and so does dotnet build -f. Neither would ever compile. And a rebuild's Clean phase evaluates and
       caches the inner builds before anything is compiled, so even when the outer build compiles first, Content
       it registers there never reaches them.

       So every inner build asks the outer build to compile, and applies what that compilation changed to its
       own items. MSBuild runs a target once per project instance and hands every later caller its cached
       Returns, so this compiles nothing when the outer build already compiled before dispatching, and compiles
       exactly once when it did not, however many frameworks or referencing apps ask. Removing TargetFramework
       is what addresses the outer instance: it is the only global property the outer build adds when it
       dispatches.

       Removed files matter as much as generated ones. This build evaluated its wwwroot glob before the
       compilation deleted the CSS of stylesheets that left a compiled directory, and the static web assets SDK
       fails on an asset whose file is gone.

       No FileWrites here: the outer build owns these files, and an inner build's incremental clean would
       otherwise delete outputs it believes are its own. SassClean removes them from the manifest instead.

       A caller that reaches this project with different global properties (a ProjectReference with
       AdditionalProperties, say) addresses a different outer instance, which compiles again. SassCompileTask
       makes those compilations take turns.

       The DesignTimeBuild guard is not what keeps the IDE from compiling: that global property reaches the outer
       instance through this call, where RunSassBeforeStaticWebAssets already skips. It saves evaluating the
       outer project on every design-time build. -->
  <Target Name="_SassCompileFromInnerBuild"
          BeforeTargets="ResolveProjectStaticWebAssets;PreBuildEvent"
          Condition="'$(SassEnabled)' == 'true' AND '@(SassBeforeStaticWebAssets)' != '' AND '$(DesignTimeBuild)' != 'true' AND '$(NoBuild)' != 'true' AND '$(TargetFrameworks)' != '' AND '$(TargetFramework)' != ''">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="RunSassBeforeStaticWebAssets"
             RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_SassOuterContentChanges" />
    </MSBuild>

    <ItemGroup>
      <_SassOuterRemovedFiles Include="@(_SassOuterContentChanges)" Condition="'%(_SassOuterContentChanges.Change)' == 'Removed'" />
      <_SassOuterGeneratedContent Include="@(_SassOuterContentChanges)" Condition="'%(_SassOuterContentChanges.Change)' == 'Generated'" />
      <Content Remove="@(_SassOuterRemovedFiles)" />
      <None Remove="@(_SassOuterRemovedFiles)" />
      <_SassOuterNewContent Include="@(_SassOuterGeneratedContent)" Exclude="@(Content)" />
      <Content Include="%(_SassOuterNewContent.Identity)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Hooked to both targets deliberately. In a single-target-framework project CoreClean runs with
       $(IntermediateOutputPath) set to obj/<config>/<tfm>/, which is where the build wrote the manifest. In
       a multi-targeted one CoreClean only runs in the inner builds, whose obj/<config>/<tfm>/ never held a
       manifest - the build ran once in the outer build and wrote to obj/<config>/. Clean does run in the
       outer build, so hooking it as well is what makes `dotnet clean` remove generated CSS from a
       multi-targeted project. Whichever hook resolves the other directory finds no manifest and deletes
       nothing, so running twice is harmless. -->
  <Target Name="SassClean"
          BeforeTargets="CoreClean;Clean"
          DependsOnTargets="_SassResolveStampDirectory">
    <ReadLinesFromFile File="$(_SassStampDirectory)/Sass.generated.txt"
                       Condition="'$(_SassStampDirectory)' != '' AND Exists('$(_SassStampDirectory)/Sass.generated.txt')">
      <Output TaskParameter="Lines" ItemName="_SassFilesToClean" />
    </ReadLinesFromFile>
    <Delete Files="@(_SassFilesToClean)" Condition="'@(_SassFilesToClean)' != ''" />
    <Delete Files="$(_SassStampDirectory)/Sass.generated.txt;$(_SassStampDirectory)/Sass.removed.txt;$(_SassStampDirectory)/Sass.settings.stamp"
            Condition="'$(_SassStampDirectory)' != ''" />
  </Target>
</Project>
