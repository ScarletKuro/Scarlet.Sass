<Project>
  <PropertyGroup>
    <!-- Sass runtime version used across all runtime packages -->
    <SassVersion>1.105.0</SassVersion>

    <!-- Revision of Scarlet.Sass.Cli within a single SassVersion. The CLI package version is
         $(SassVersion).$(SassCliRevision), and NuGet normalises a trailing zero away, so revision 0
         publishes as plain 1.104.1.

         Bump this to ship a CLI-only fix without waiting for a new Sass: 1.104.1 -> 1.104.1.1. Reset it to 0
         whenever SassVersion changes. It lives here, next to SassVersion, because the alternative is
         discovering at release time that the deploy silently dropped your fix - the push skips duplicates,
         so a rebuilt package at an unchanged version never reaches the feed. -->
    <SassCliRevision>0</SassCliRevision>
  </PropertyGroup>
</Project>
