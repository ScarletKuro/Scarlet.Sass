<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    
    <!-- Enable Sass runtime download mode -->
    <SassRuntimeDownload>true</SassRuntimeDownload>
    <SassVersionDownload>1.104.1</SassVersionDownload>
    <SassRuntimeDirectory>$(MSBuildProjectDirectory)/runtimes</SassRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Import the Sass targets from the referenced project (development scenario) -->
  <Import Project="..\..\src\Scarlet.Sass.MSBuild\Scarlet.Sass.MSBuild.targets" />

  <ItemGroup>
    <SassBeforeStaticWebAssets Include="assets\styles">
      <OutputPath>wwwroot\css</OutputPath>
      <OutputStyle>Compressed</OutputStyle>
      <SourceMap>true</SourceMap>
    </SassBeforeStaticWebAssets>
  </ItemGroup>

  <Target Name="VerifySassOutput" AfterTargets="RunSassBeforeStaticWebAssets">
    <Error Text="CSS output was not created." Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\style.css')" />
    <Message Text="Sass download build completed successfully." Importance="high" />
  </Target>

</Project>
